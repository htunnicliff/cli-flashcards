{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "tool": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "variant": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "toolVersion": {
      "type": "string",
      "minLength": 1
    },
    "deckVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "source": {
      "type": "string",
      "enum": [
        "manpage",
        "help",
        "manual"
      ]
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "attribution": {
      "type": "string",
      "minLength": 1
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[^\\s:]+$"
          },
          "flags": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^--?[^\\s=:-][^\\s=:]*$"
            }
          },
          "primary": {
            "type": "string",
            "pattern": "^--?[^\\s=:-][^\\s=:]*$"
          },
          "argument": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "optional": {
                "default": false,
                "type": "boolean"
              }
            },
            "required": [
              "name"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "default": "",
            "type": "string"
          },
          "tier": {
            "type": "string",
            "enum": [
              "core",
              "common",
              "obscure"
            ]
          },
          "examples": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "command": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string"
                }
              },
              "required": [
                "command"
              ]
            }
          },
          "tags": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "hidden": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "flags",
          "summary",
          "tier"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "tool",
    "variant",
    "toolVersion",
    "deckVersion",
    "source",
    "license",
    "attribution",
    "options"
  ],
  "$id": "https://github.com/htunnicliff/cli-flashcards/schemas/deck.schema.json",
  "title": "CLI Flashcards deck"
}
