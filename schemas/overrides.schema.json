{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "deck": {
      "type": "object",
      "properties": {
        "license": {
          "type": "string",
          "minLength": 1
        },
        "attribution": {
          "type": "string",
          "minLength": 1
        },
        "toolVersion": {
          "type": "string",
          "minLength": 1
        },
        "parsingStyle": {
          "type": "string",
          "enum": [
            "gnu",
            "posix",
            "strict"
          ]
        }
      },
      "additionalProperties": false
    },
    "options": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[^\\s:]+$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "tier": {
            "type": "string",
            "enum": [
              "core",
              "common",
              "obscure"
            ]
          },
          "primary": {
            "type": "string",
            "pattern": "^--?[^\\s=:-][^\\s=:]*$"
          },
          "argument": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "optional": {
                    "default": false,
                    "type": "boolean"
                  }
                },
                "required": [
                  "name"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "examples": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "command": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string"
                }
              },
              "required": [
                "command"
              ]
            }
          },
          "replaceExamples": {
            "type": "boolean"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "hidden": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "merge": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "into": {
            "type": "string",
            "pattern": "^[^\\s:]+$"
          },
          "from": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[^\\s:]+$"
            }
          }
        },
        "required": [
          "into",
          "from"
        ],
        "additionalProperties": false
      }
    },
    "add": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[^\\s:]+$"
          },
          "flags": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^--?[^\\s=:-][^\\s=:]*$"
            }
          },
          "primary": {
            "type": "string",
            "pattern": "^--?[^\\s=:-][^\\s=:]*$"
          },
          "argument": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "optional": {
                "default": false,
                "type": "boolean"
              }
            },
            "required": [
              "name"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "default": "",
            "type": "string"
          },
          "tier": {
            "default": "common",
            "type": "string",
            "enum": [
              "core",
              "common",
              "obscure"
            ]
          },
          "examples": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "command": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string"
                }
              },
              "required": [
                "command"
              ]
            }
          },
          "tags": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "hidden": {
            "default": false,
            "type": "boolean"
          },
          "subcommand": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          }
        },
        "required": [
          "flags",
          "summary"
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$id": "https://github.com/htunnicliff/cli-flashcards/schemas/overrides.schema.json",
  "title": "CLI Flashcards deck overrides"
}
