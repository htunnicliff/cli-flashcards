{
  "name": "cli-flashcards",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Spaced repetition flashcards for learning command-line flags.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "typecheck": "tsc --build",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "schema:export": "jiti tools/export-schema.ts",
    "deck:generate": "jiti tools/deck-generate.ts",
    "decks:check": "jiti tools/check-decks.ts",
    "deck:report": "jiti tools/deck-report.ts",
    "tldr:vendor": "jiti tools/vendor-tldr.ts",
    "deck:build": "jiti tools/deck-build.ts",
    "fixtures:golden": "jiti tools/fixtures-golden.ts"
  },
  "dependencies": {
    "ts-fsrs": "^5.4.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.7",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.3",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1",
    "yaml": "^2.9.1"
  }
}
